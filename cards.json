        {
          "source": "한국어기초사전",
          "pos": "명사",
          "type": "",
          "level": "고급",
          "definition": "(옛날에) 땅 주인을 대신하여 농지를 관리하는 사람.",
          "link": "https://krdict.korean.go.kr/kor/dicSearch/SearchView?ParaWordNo=51760",
          "translations": {
            "영어": {
              "word": "supervisor of a tenant farm",
              "dfn": "(archaic) A person who supervises tenants and manages farm land on behalf of its owner."
            },
            "일본어": {
              "word": "マルム。こさくちかんりにん【小作地管理人】",
              "dfn": "昔、地主に代わって農地を管理する人。"
            },
            "프랑스어": {
              "word": "mareum, agent du propriétaire, gérant, régisseur",
              "dfn": "(archaïque) Personne chargée de gérer des terres pour le compte de leur propriétaire."
            },
            "스페인어": {
              "word": "mareum, supervisor de campo agrícola, administrador",
              "dfn": "(ARCAICO) Persona que administra los terrenos agrícolas en lugar del propietario."
            },
            "아랍어": {
              "word": "مشرف مزرعة المستأجر، خولي",
              "dfn": "(في قديم الزمان) شخص يقوم بإدارة المزرعة نيابة عن صاحب الأرض"
            },
            "몽골어": {
              "word": "сахиул",
              "dfn": "(эрт цагт) газрын эзний оронд тариалангийн талбайг зохион байгуулдаг хүн."
            },
            "베트남어": {
              "word": "mareum; cai tổng, cai điền",
              "dfn": "(ngày xưa) Người quản lý ruộng đất thay địa chủ."
            },
            "타이어": {
              "word": "มารึม",
              "dfn": "(ในอดีต)คนที่ดูแลที่ดินเพาะปลูกแทนเจ้าของที่ดิน"
            },
            "인도네시아어": {
              "word": "pengelola ladang",
              "dfn": "(pada zaman dulu) orang yang mengelola lahan pertanian menggantikan pemilik tanah"
            },
            "러시아어": {
              "word": "марым",
              "dfn": "(архаизм) Человек, управляющий земельным участком вместо владельца."
            },
            "중국어": {
              "word": "二东家，二地主",
              "dfn": "(旧词)替土地主人管理农田的人。"
            }
          }
        }
      ]
